{
  "name": "aei-relay",
  "version": "1.1.0",
  "private": true,
  "description": "Cloudflare Worker relay for the ÆEA Mini App — proxies Yahoo Finance through Cloudflare's edge to avoid Heroku egress rate-limits.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:router": "wrangler deploy --config wrangler-router.toml",
    "tail": "wrangler tail",
    "tail:router": "wrangler tail --config wrangler-router.toml",
    "secret:key": "wrangler secret put RELAY_KEY",
    "kv:create": "wrangler kv:namespace create RELAY_KV",
    "kv:list": "wrangler kv:namespace list"
  },
  "devDependencies": {
    "wrangler": "^3.80.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "UNLICENSED"
}